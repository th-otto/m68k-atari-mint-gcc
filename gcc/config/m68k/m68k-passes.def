/* Canonicalize 3-register scaled index addresses for LRA compatibility.

   fwprop substitutes (plus idx idx) for idx*2 into memory addresses, and
   simplify_gen_binary reassociates the result to (plus (plus base idx) idx).
   m68k_legitimate_address_p accepts this 3-register form for 68020+, but
   LRA's decompose_normal_address can only classify 2 register operands.

   This pass rewrites (plus (plus base idx) idx) to (plus base (ashift idx 1))
   which is the canonical scaled index form that both reload and LRA handle.

   Runs after avail_copy_elim (which also runs after inc_dec), before IRA.  */

INSERT_PASS_AFTER (pass_inc_dec, 1, m68k_pass_canon_scaled_index);

/* Break false partial-write live ranges before IRA.

   When a pseudo is built from partial writes (bfins + strict_low_part)
   that collectively cover all 32 bits, DF treats each as read-modify-write.
   Via loop back-edges, the pseudo appears live across calls, forcing IRA
   to use callee-saved registers.  This pass inserts a zero-cost clobber
   before the first partial write to break the false dependency.

   Runs immediately before IRA so all pre-RA transforms have completed.  */

INSERT_PASS_BEFORE (pass_ira, 1, m68k_pass_break_false_dep);

/* Clean up standalone (clobber (reg pseudo)) insns inserted by
   break_false_dep.  They served their purpose for IRA liveness but LRA
   does not assign hard registers to standalone clobbers.

   Runs after reload, before postreload (which uses cselib).  */

INSERT_PASS_BEFORE (pass_postreload, 1, m68k_pass_break_false_dep_cleanup);
