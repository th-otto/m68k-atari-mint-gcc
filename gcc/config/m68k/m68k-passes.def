/* Narrow index multiply optimization for m68k .w indexing.

   Narrows 32-bit multiplies to 16-bit when safe, enabling .w indexed
   addressing which sign-extends automatically.  Handles both explicit
   casts from narrow types and 32-bit values with VRP-constrained ranges.

   Runs after VRP1 to see range constraints from [[assume(...)]].  */

INSERT_PASS_AFTER (pass_vrp, 1, m68k_pass_narrow_index_mult);

/* Normalize increment positions for auto-increment optimization.

   When GCC's IVOPTS pass places pointer increments in the middle of a
   sequence of memory accesses, it can result in some accesses using
   negative offsets (e.g., -2(%a0)).  This prevents conversion to
   POST_INC addressing mode.

   This pass detects such patterns and moves the increment to after all
   memory accesses, adjusting negative offsets to positive:

   Before:
     move.w (%a0),(%a1)
     move.w 2(%a0),2(%a1)
     move.w 4(%a0),4(%a1)
     addq.l #8,%a0
     addq.l #8,%a1
     move.w -2(%a0),-2(%a1)    ; negative offset blocks POST_INC

   After:
     move.w (%a0),(%a1)
     move.w 2(%a0),2(%a1)
     move.w 4(%a0),4(%a1)
     move.w 6(%a0),6(%a1)      ; adjusted to positive
     addq.l #8,%a0             ; moved to end
     addq.l #8,%a1

   This runs before m68k_pass_opt_autoinc to enable full POST_INC conversion,
   and before peephole2 which can then merge adjacent word moves into longs.  */

INSERT_PASS_BEFORE (pass_peephole2, 1, m68k_pass_normalize_autoinc);

/* A post reload optimization pass that converts indexed addressing to
   POST_INC or PRE_DEC addressing modes.  m68k has efficient (ax)+ and -(ax)
   addressing modes that perform memory access and pointer arithmetic in
   a single instruction.

   The pass finds patterns like:
     move.l (a0),d0
     move.l 4(a0),d1
     lea 8(a0),a0

   And converts them to:
     move.l (a0)+,d0
     move.l (a0)+,d1

   This runs after peephole2 to catch opportunities that other passes miss.  */

INSERT_PASS_AFTER (pass_peephole2, 1, m68k_pass_opt_autoinc);
